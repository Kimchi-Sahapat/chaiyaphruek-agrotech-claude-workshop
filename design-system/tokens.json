{
  "$schema": "https://design-tokens.org/schema.json",
  "$description": "ชัยพฤกษ์ อโกรเทค (Chaiyapreuk Agrotech) design tokens. Tool-agnostic source of truth (W3C Design Tokens format). Derived from design.md CI guide.",
  "color": {
    "brand": {
      "green": {
        "$value": "#4DB748",
        "$type": "color",
        "$description": "Lime Green — primary/dominant background across all materials. Green is ALWAYS dominant."
      },
      "navy": {
        "$value": "#1B3A8C",
        "$type": "color",
        "$description": "Deep Navy Blue — the word 'ชัยพฤกษ์', major headlines, numbered elements, logo text."
      },
      "red": {
        "$value": "#E8323C",
        "$type": "color",
        "$description": "Festival Red — the word 'อโกรเทค', urgency, CTAs, activity numbers, logo ring."
      },
      "gold": {
        "$value": "#FFD700",
        "$type": "color",
        "$description": "Harvest Gold — prize callouts, 'นาทีทอง', the single most important word."
      },
      "white": {
        "$value": "#FFFFFF",
        "$type": "color",
        "$description": "Pure White — primary text on green, stroke/outline on large navy or red text."
      }
    },
    "secondary": {
      "green-dark": {
        "$value": "#1E7B34",
        "$type": "color",
        "$description": "Forest Green — footer backgrounds, borders, text on light areas."
      },
      "green-light": {
        "$value": "#7DC75A",
        "$type": "color",
        "$description": "Radial Ray Green — sunburst/ray pattern on green backgrounds."
      },
      "cream": {
        "$value": "#FFFDE0",
        "$type": "color",
        "$description": "Soft Cream — footer strips, panel backgrounds, logo badges."
      }
    },
    "role": {
      "background": { "$value": "{color.brand.green}", "$type": "color", "$description": "Default page/post background. Never use dark/black backgrounds." },
      "surface": { "$value": "{color.secondary.cream}", "$type": "color", "$description": "Panels, cards, badges on top of green." },
      "text-on-green": { "$value": "{color.brand.white}", "$type": "color" },
      "headline": { "$value": "{color.brand.navy}", "$type": "color" },
      "cta": { "$value": "{color.brand.red}", "$type": "color" },
      "cta-text": { "$value": "{color.brand.white}", "$type": "color" },
      "highlight": { "$value": "{color.brand.gold}", "$type": "color" },
      "footer-bg": { "$value": "{color.secondary.green-dark}", "$type": "color" }
    }
  },
  "brandName": {
    "$description": "CRITICAL: standalone brand-name text always splits into two colors. In the circular logo mark both words are navy.",
    "chaiyapreuk": { "$value": "{color.brand.navy}", "$type": "color", "$description": "'ชัยพฤกษ์' as standalone text = Navy." },
    "agrotech": { "$value": "{color.brand.red}", "$type": "color", "$description": "'อโกรเทค' as standalone text = Red." }
  },
  "font": {
    "family": {
      "primary": { "$value": "Kanit", "$type": "fontFamily", "$description": "Kanit — rounds well, legible on mobile. Use for everything." },
      "fallback": { "$value": ["Noto Sans Thai", "system-ui", "sans-serif"], "$type": "fontFamily" }
    },
    "weight": {
      "regular": { "$value": 400, "$type": "fontWeight", "$description": "Body copy, contact info." },
      "medium": { "$value": 500, "$type": "fontWeight" },
      "bold": { "$value": 700, "$type": "fontWeight", "$description": "Subheadlines, product names, dates." },
      "extrabold": { "$value": 800, "$type": "fontWeight", "$description": "Hero headlines, campaign names." }
    },
    "lineHeight": {
      "headline": { "$value": 1.15, "$type": "number", "$description": "1.1–1.2 for headlines." },
      "body": { "$value": 1.4, "$type": "number" }
    }
  },
  "fontSize": {
    "$description": "Two scales. 'poster' = for 1080×1080 social artwork (px). 'ui' = for web/app text (rem).",
    "poster": {
      "hero": { "$value": "110px", "$type": "dimension", "$description": "Hero text 90–130px, ExtraBold, White or Gold." },
      "subhead": { "$value": "60px", "$type": "dimension", "$description": "50–70px, Bold, White." },
      "support": { "$value": "38px", "$type": "dimension", "$description": "30–45px, Regular/Medium, White." },
      "footer": { "$value": "25px", "$type": "dimension", "$description": "22–28px, Regular, White." }
    },
    "ui": {
      "xs": { "$value": "0.75rem", "$type": "dimension" },
      "sm": { "$value": "0.875rem", "$type": "dimension" },
      "base": { "$value": "1rem", "$type": "dimension" },
      "lg": { "$value": "1.25rem", "$type": "dimension" },
      "xl": { "$value": "1.5rem", "$type": "dimension" },
      "2xl": { "$value": "2rem", "$type": "dimension" },
      "3xl": { "$value": "2.5rem", "$type": "dimension" },
      "hero": { "$value": "3.5rem", "$type": "dimension" }
    }
  },
  "space": {
    "0": { "$value": "0", "$type": "dimension" },
    "1": { "$value": "0.25rem", "$type": "dimension" },
    "2": { "$value": "0.5rem", "$type": "dimension" },
    "3": { "$value": "0.75rem", "$type": "dimension" },
    "4": { "$value": "1rem", "$type": "dimension" },
    "6": { "$value": "1.5rem", "$type": "dimension" },
    "8": { "$value": "2rem", "$type": "dimension" },
    "12": { "$value": "3rem", "$type": "dimension" },
    "16": { "$value": "4rem", "$type": "dimension" }
  },
  "radius": {
    "$description": "All badge/label overlays use rounded corners — never sharp.",
    "sm": { "$value": "8px", "$type": "dimension" },
    "md": { "$value": "16px", "$type": "dimension" },
    "lg": { "$value": "24px", "$type": "dimension" },
    "pill": { "$value": "999px", "$type": "dimension", "$description": "White pill badge, rounded labels." }
  },
  "shadow": {
    "float": {
      "$value": { "offsetX": "0", "offsetY": "8px", "blur": "24px", "spread": "0", "color": "rgba(27,58,140,0.25)" },
      "$type": "shadow",
      "$description": "Floating product/prize images shown at a slight angle."
    }
  },
  "gradient": {
    "banner": {
      "$value": "linear-gradient(90deg, #4DB748 0%, #7DC75A 100%)",
      "$type": "gradient",
      "$description": "Green-to-light-green (left→right) for horizontal banners."
    }
  },
  "canvas": {
    "$description": "Export sizes. Do not use dark backgrounds; keep green dominant.",
    "fb-feed": { "$value": "1080x1080", "$type": "other", "$description": "Facebook Feed, square — primary format." },
    "fb-story": { "$value": "1080x1920", "$type": "other", "$description": "Facebook Story, vertical." },
    "line-broadcast": { "$value": "1040x1040", "$type": "other", "$description": "LINE OA broadcast, square." },
    "banner": { "$value": "1640x856", "$type": "other", "$description": "FB cover / event banner, horizontal." },
    "print": { "$value": "300dpi", "$type": "other", "$description": "Print/signage — same CI, scale resolution." }
  }
}
